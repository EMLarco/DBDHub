@model DBDHub.Models.Survivor
@{
    ViewData["Title"] = "Detalle del Superviviente";
}

<h1>@Model.Nombre</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Historia</dt>
    <dd class="col-sm-9">@(Model.Historia ?? "-")</dd>
    <dt class="col-sm-3">Dificultad</dt>
    <dd class="col-sm-9">@(Model.Dificultad ?? "-")</dd>
</dl>

@if (Model.Perks?.Any() == true)
{
    <h3>Perks</h3>
    <table class="table table-sm">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Nivel</th></tr></thead>
        <tbody>
        @foreach (var perk in Model.Perks)
        {
            <tr>
                <td>@perk.Nombre</td>
                <td>@(perk.Descripcion ?? "-")</td>
                <td>@perk.Nivel</td>
            </tr>
        }
        </tbody>
    </table>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>