@model IEnumerable<DBDHub.Models.Survivor>
@{
    ViewData["Title"] = "Supervivientes";
    int pagina = (int)ViewData["pagina"];
    int tamano = (int)ViewData["tamano"];
    int totalRegistros = (int)ViewData["totalRegistros"];
    string buscar = ViewData["buscar"]?.ToString() ?? "";
    int totalPaginas = (int)Math.Ceiling((double)totalRegistros / tamano);
}

<div class="container-fluid mt-4 px-3">
    <h1 class="mb-4" style="color: #ff3e3e; text-transform: uppercase; letter-spacing: 2px;">
        <i class="fas fa-user-shield me-2"></i>@ViewData["Title"]
    </h1>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> Nuevo superviviente
        </a>
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="buscar" class="form-control me-2" placeholder="Buscar..." value="@buscar" />
            <button type="submit" class="btn btn-primary me-1"><i class="fas fa-search"></i></button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i></a>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">No se encontraron supervivientes.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var survivor in Model)
            {
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    @await Html.PartialAsync("_SurvivorCard", survivor)
                </div>
            }
        </div>
    }

    @if (totalPaginas > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pagina == 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-pagina="@(pagina - 1)" asp-route-buscar="@buscar">
                        <i class="fas fa-chevron-left"></i> Anterior
                    </a>
                </li>
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")">
                        <a class="page-link" asp-route-pagina="@i" asp-route-buscar="@buscar">@i</a>
                    </li>
                }
                <li class="page-item @(pagina == totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-route-pagina="@(pagina + 1)" asp-route-buscar="@buscar">
                        Siguiente <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
    <p class="text-muted text-center">Página @pagina de @totalPaginas — Total: @totalRegistros supervivientes</p>
</div>