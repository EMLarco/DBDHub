@using Microsoft.AspNetCore.Identity
@inject SignInManager<DBDHub.Models.ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DBD Hub</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Tus estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Iconos Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Fuentes de Google (opcional) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-danger shadow-sm">
            <div class="container-fluid">
                <!-- Logo y nombre -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQzZgnDkXp8IOq832JJznitxFgv9qhcGVHAsA&s"
                         alt="DBD Logo" width="40" height="40" class="me-2 rounded-circle border border-danger" />
                    <span class="fw-bold text-danger" style="letter-spacing: 2px;">DBD Hub</span>
                </a>

                <!-- Botón hamburguesa para móviles -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Enlaces de navegación -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Killers" asp-action="Index">
                                <i class="fas fa-skull me-1"></i> Asesinos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Survivors" asp-action="Index">
                                <i class="fas fa-user-shield me-1"></i> Supervivientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Perks" asp-action="Index">
                                <i class="fas fa-star me-1"></i> Perks
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Addons" asp-action="Index">
                                <i class="fas fa-puzzle-piece me-1"></i> Addons
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Maps" asp-action="Index">
                                <i class="fas fa-map me-1"></i> Mapas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Matches" asp-action="Index">
                                <i class="fas fa-history me-1"></i> Partidas
                            </a>
                        </li>
                    </ul>

                    <!-- Opciones de autenticación -->
                    <ul class="navbar-nav ms-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                    <i class="fas fa-user me-1"></i> @User.Identity?.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link" style="display:inline; padding:8px;">
                                        <i class="fas fa-sign-out-alt me-1"></i> Salir
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus me-1"></i> Registro
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-danger text-muted mt-5">
        <div class="container-fluid text-center py-3">
            <small>&copy; @DateTime.Now.Year - DBD Hub | Dead by Daylight Wiki Interactiva</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>