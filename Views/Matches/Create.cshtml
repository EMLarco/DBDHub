@model DBDHub.Models.Match
@{
    ViewData["Title"] = "Nueva Partida";
}

<div class="container mt-4">
    <h1><i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]</h1>
    <hr />

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FechaPartida" class="form-label">Fecha de la partida</label>
                <input asp-for="FechaPartida" class="form-control" type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <span asp-validation-for="FechaPartida" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="KillerId" class="form-label">Killer</label>
                <select asp-for="KillerId" class="form-select" asp-items="ViewBag.KillerList">
                    <option value="">-- Selecciona un killer --</option>
                </select>
                <span asp-validation-for="KillerId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MapId" class="form-label">Mapa</label>
            <select asp-for="MapId" class="form-select" asp-items="ViewBag.MapList">
                <option value="">-- Selecciona un mapa --</option>
            </select>
            <span asp-validation-for="MapId" class="text-danger"></span>
        </div>

        <h2 class="h5 mt-4"><i class="fas fa-users me-2"></i>Supervivientes</h2>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Survivor1Id" class="form-label">Superviviente 1</label>
                <select asp-for="Survivor1Id" class="form-select" asp-items="ViewBag.SurvivorList">
                    <option value="">-- Selecciona --</option>
                </select>
                <span asp-validation-for="Survivor1Id" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Survivor2Id" class="form-label">Superviviente 2</label>
                <select asp-for="Survivor2Id" class="form-select" asp-items="ViewBag.SurvivorList">
                    <option value="">-- Selecciona --</option>
                </select>
                <span asp-validation-for="Survivor2Id" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Survivor3Id" class="form-label">Superviviente 3</label>
                <select asp-for="Survivor3Id" class="form-select" asp-items="ViewBag.SurvivorList">
                    <option value="">-- Selecciona --</option>
                </select>
                <span asp-validation-for="Survivor3Id" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Survivor4Id" class="form-label">Superviviente 4</label>
                <select asp-for="Survivor4Id" class="form-select" asp-items="ViewBag.SurvivorList">
                    <option value="">-- Selecciona --</option>
                </select>
                <span asp-validation-for="Survivor4Id" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Result" class="form-label">Resultado</label>
                <select asp-for="Result" class="form-select">
                    <option value="Merciless Killer">Merciless Killer</option>
                    <option value="Ruthless Killer">Ruthless Killer</option>
                    <option value="Brutal Killer">Brutal Killer</option>
                    <option value="Dead">Dead</option>
                </select>
                <span asp-validation-for="Result" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="TotalScore" class="form-label">Puntuación total</label>
                <input asp-for="TotalScore" class="form-control" type="number" min="0" />
                <span asp-validation-for="TotalScore" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="DuracionSegundos" class="form-label">Duración (segundos)</label>
                <input asp-for="DuracionSegundos" class="form-control" type="number" min="0" />
                <span asp-validation-for="DuracionSegundos" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="Detail1" class="form-label">Puntos superviviente 1</label>
                <input asp-for="Detail1" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Detail2" class="form-label">Puntos superviviente 2</label>
                <input asp-for="Detail2" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Detail3" class="form-label">Puntos superviviente 3</label>
                <input asp-for="Detail3" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Detail4" class="form-label">Puntos superviviente 4</label>
                <input asp-for="Detail4" class="form-control" type="number" min="0" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Guardar partida</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
