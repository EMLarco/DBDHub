@model DBDHub.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="text-center mb-4">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQzZgnDkXp8IOq832JJznitxFgv9qhcGVHAsA&s" 
                     alt="DBD Logo" width="80" height="80" class="rounded-circle border border-danger p-1" />
                <h2 class="text-danger mt-3 text-uppercase" style="letter-spacing: 2px;">Únete a la Niebla</h2>
            </div>
            <div class="card bg-dark border-danger shadow-lg">
                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label text-light">Usuario</label>
                            <input asp-for="Username" class="form-control bg-dark text-light border-secondary" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-light">Contraseña</label>
                            <input asp-for="Password" class="form-control bg-dark text-light border-secondary" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label text-light">Confirmar contraseña</label>
                            <input asp-for="ConfirmPassword" class="form-control bg-dark text-light border-secondary" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 text-uppercase fw-bold">Registrarse</button>
                        <p class="mt-3 text-center text-muted">¿Ya tienes cuenta? <a asp-action="Login" class="text-danger">Inicia sesión</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>