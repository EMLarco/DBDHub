@model IEnumerable<DBDHub.Models.Killer>
@{
    ViewData["Title"] = "Asesinos";
    int pagina = (int)ViewData["pagina"];
    int tamano = (int)ViewData["tamano"];
    int totalRegistros = (int)ViewData["totalRegistros"];
    string buscar = ViewData["buscar"]?.ToString() ?? "";
    int totalPaginas = (int)Math.Ceiling((double)totalRegistros / tamano);
}

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="fas fa-skull me-2"></i>@ViewData["Title"]
    </h1>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> Nuevo asesino
        </a>
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="buscar" class="form-control me-2" placeholder="Buscar asesino..." value="@buscar" />
            <button type="submit" class="btn btn-primary me-1">
                <i class="fas fa-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i>
            </a>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            <i class="fas fa-exclamation-triangle me-2"></i>No se encontraron asesinos.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var killer in Model)
            {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-3">
                @await Html.PartialAsync("_KillerCard", killer)
            </div>
            }
        </div>
    }

    @* Paginación *@
    @if (totalPaginas > 1)
    {
        <nav aria-label="Paginación" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pagina == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)" asp-route-buscar="@buscar">
                        <i class="fas fa-chevron-left"></i> Anterior
                    </a>
                </li>
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@buscar">@i</a>
                    </li>
                }
                <li class="page-item @(pagina == totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)" asp-route-buscar="@buscar">
                        Siguiente <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }

    <p class="text-muted text-center mt-2">
        <i class="fas fa-hashtag"></i> Página @pagina de @totalPaginas — Total: @totalRegistros asesinos
    </p>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tiers = ['purple-tier', 'green-tier', 'yellow-tier'];
            let currentTierIndex = 0; // empezamos todos en púrpura

            // Seleccionamos todos los diamantes
            const allPerks = document.querySelectorAll('.dbd-perk-background');

            // Función para aplicar la clase actual a todos
            function applyTierToAll() {
                const currentClass = tiers[currentTierIndex];
                allPerks.forEach(bg => {
                    // Removemos cualquier tier anterior
                    bg.classList.remove('purple-tier', 'green-tier', 'yellow-tier');
                    // Añadimos la nueva
                    bg.classList.add(currentClass);
                });
            }

            // Aplicar la inicial (púrpura)
            applyTierToAll();

            // Cambiar todos juntos cada 1 segundo
            setInterval(() => {
                currentTierIndex = (currentTierIndex + 1) % tiers.length;
                applyTierToAll();
            }, 1000);
        });
    </script>
}