@model IEnumerable<DBDHub.Models.Killer>
@{
    ViewData["Title"] = "Asesinos";
    int pagina = (int)ViewData["pagina"];
    int tamano = (int)ViewData["tamano"];
    int totalRegistros = (int)ViewData["totalRegistros"];
    string buscar = ViewData["buscar"]?.ToString() ?? "";
    int totalPaginas = (int)Math.Ceiling((double)totalRegistros / tamano);
}

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="fas fa-skull me-2"></i>@ViewData["Title"]
    </h1>

    <p>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> Nuevo asesino
        </a>
    </p>

    @* Buscador *@
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="buscar" class="form-control" placeholder="Buscar asesino..." value="@buscar" />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i> Buscar
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Limpiar
            </a>
        </div>
    </form>

    @* Tabla *@
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th><i class="fas fa-user-secret"></i> Nombre</th>
                    <th><i class="fas fa-bolt"></i> Poder</th>
                    <th><i class="fas fa-tachometer-alt"></i> Dificultad</th>
                    <th><i class="fas fa-running"></i> Velocidad</th>
                    <th><i class="fas fa-cogs"></i> Acciones</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@(item.Poder ?? "-")</td>
                    <td>@(item.Dificultad ?? "-")</td>
                    <td>@item.Velocidad</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalle">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>

    @* Paginación *@
    @if (totalPaginas > 1)
    {
        <nav aria-label="Paginación">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pagina == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)" asp-route-buscar="@buscar">
                        <i class="fas fa-chevron-left"></i> Anterior
                    </a>
                </li>
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@buscar">@i</a>
                    </li>
                }
                <li class="page-item @(pagina == totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)" asp-route-buscar="@buscar">
                        Siguiente <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }

    <p class="text-muted text-center">
        <i class="fas fa-hashtag"></i> Página @pagina de @totalPaginas — Total: @totalRegistros asesinos
    </p>
</div>