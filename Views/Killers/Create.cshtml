@model DBDHub.Models.Killer
@{
    ViewData["Title"] = "Nuevo Asesino";
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Poder" class="form-label"></label>
        <input asp-for="Poder" class="form-control" />
        <span asp-validation-for="Poder" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Velocidad" class="form-label"></label>
        <input asp-for="Velocidad" class="form-control" />
        <span asp-validation-for="Velocidad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Dificultad" class="form-label"></label>
        <input asp-for="Dificultad" class="form-control" />
        <span asp-validation-for="Dificultad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Historia" class="form-label"></label>
        <textarea asp-for="Historia" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Historia" class="text-danger"></span>
    </div>

    <div class="mb-3">
    <label asp-for="ImagenUrl" class="form-label"></label>
    <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
    <span asp-validation-for="ImagenUrl" class="text-danger"></span>
</div>

    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>